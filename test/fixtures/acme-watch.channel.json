{
  "format": "channel-v1",
  "slug": "acme-competitors",
  "name": "Acme competitor brief",
  "topic": "what Copilot at Microsoft and Gemini at Google launch, change and announce",
  "audience": "Acme's product and sales teams",
  "run_by": "Acme",
  "formats": ["digest"],
  "how_many": 20,
